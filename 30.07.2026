func CreateInquiryHandler(c echo.Context) error {
	incidentID := c.Param("id")
	
	// 1. Получаем текстовые поля из multipart-формы
	targetOrg := c.FormValue("target_org")
	description := c.FormValue("description")
	inquiryType := c.FormValue("type")

	if inquiryType == "" {
		inquiryType = "MANUAL"
	}

	// 2. Читаем файл, если он прикреплен
	fileHeader, err := c.FormFile("file")
	var fileBytes []byte
	var fileName string

	if err == nil && fileHeader != nil {
		// Проверка размера файла на стороне Go (доп. защита)
		if fileHeader.Size > 10*1024*1024 {
			return c.JSON(http.StatusBadRequest, echo.Map{"error": "Файл превышает 10 МБ"})
		}

		src, err := fileHeader.Open()
		if err != nil {
			return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Не удалось открыть файл"})
		}
		defer src.Close()

		fileBytes, err = io.ReadAll(src)
		if err != nil {
			return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Ошибка чтения файла"})
		}
		fileName = fileHeader.Filename
	}

	// 3. Формируем Payload для внешнего сервиса / БД
	reqPayload := ExternalInquiryPayload{
		BIN:     SenderBIN,
		Type:    inquiryType,
		Subject: "Запрос информации по инциденту",
		AdditionalData: map[string]interface{}{
			"target_organization": targetOrg,
			"description":         description,
			"file_name":           fileName,
			// Файл при необходимости можно кодировать в Base64 для внешнего API:
			// "file_base64":      base64.StdEncoding.EncodeToString(fileBytes),
		},
	}

	// ... дальнейшая отправка и вызов SaveCreateInquiryRawTarget ...
}
